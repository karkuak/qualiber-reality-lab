{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "erl2:environment",
  "title": "ERL2 environment driver, clean-control, frontier and substrate-lock contracts",
  "$comment": "Design v2 \u00a79/\u00a712/\u00a722 and implementation plan \u00a79. No contract here names a product or a subject-supported evidence class: source kinds are open identifiers owned by the environment contract (ERL2-FR-002).",
  "$defs": {
    "DriverOperation": {
      "enum": [
        "provision",
        "probe",
        "mutate",
        "restore",
        "destroy",
        "inspect"
      ]
    },
    "EnvironmentDriverManifestV1": {
      "$comment": "A driver is admissible only when `enabled` is true. The Compose driver stays disabled while its substrate lock is unqualified (ERL2-OQ-005).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "driver_id",
        "driver_kind",
        "version",
        "supported_operations",
        "resource_kinds",
        "enabled",
        "core_hash",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-driver-manifest/v1"
        },
        "driver_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "driver_kind": {
          "enum": [
            "fake",
            "compose"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "supported_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "erl2:environment#/$defs/DriverOperation"
          }
        },
        "resource_kinds": {
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "substrate_lock_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "enabled": {
          "type": "boolean"
        },
        "disabled_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "activation_gate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "signature": {
          "$ref": "erl2:common#/$defs/Signature"
        }
      },
      "allOf": [
        {
          "$comment": "A disabled driver must state why and name its activation gate; an enabled driver may not carry either field.",
          "if": {
            "type": "object",
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "disabled_reason_code",
              "activation_gate"
            ]
          },
          "else": {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "disabled_reason_code"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "activation_gate"
                  ]
                }
              ]
            }
          }
        },
        {
          "$comment": "A Compose driver is only admissible against a qualified substrate lock.",
          "if": {
            "type": "object",
            "properties": {
              "driver_kind": {
                "const": "compose"
              }
            },
            "required": [
              "driver_kind"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "substrate_lock_hash"
            ]
          }
        }
      ]
    },
    "SubstrateLockV1": {
      "$comment": "ERL2-OQ-005. Qualification requires the archive digest, per-platform image digests, SBOM and provenance, and config hashes, all re-verified before an attesting run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "lock_id",
        "substrate_id",
        "qualification_status",
        "source_archive",
        "images",
        "config_hashes",
        "recorded_at",
        "core_hash",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "substrate-lock/v1"
        },
        "lock_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "substrate_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "qualification_status": {
          "enum": [
            "qualified",
            "unqualified_pending_erl2_oq_005"
          ]
        },
        "unqualified_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_tag",
            "source_commit",
            "archive_sha256"
          ],
          "properties": {
            "release_tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source_commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "archive_sha256": {
              "$ref": "erl2:common#/$defs/Hash"
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service_id",
              "platform",
              "digest"
            ],
            "properties": {
              "service_id": {
                "$ref": "erl2:common#/$defs/Id"
              },
              "platform": {
                "enum": [
                  "linux/amd64",
                  "linux/arm64",
                  "darwin/arm64"
                ]
              },
              "digest": {
                "$ref": "erl2:common#/$defs/Hash"
              }
            }
          }
        },
        "sbom": {
          "$ref": "erl2:common#/$defs/ArtifactRef"
        },
        "provenance": {
          "$ref": "erl2:common#/$defs/Provenance"
        },
        "config_hashes": {
          "$ref": "erl2:common#/$defs/UniqueHashArray"
        },
        "recorded_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "signature": {
          "$ref": "erl2:common#/$defs/Signature"
        }
      },
      "allOf": [
        {
          "$comment": "A qualified lock requires at least one image digest, an SBOM and provenance, and forbids an unqualified reason.",
          "if": {
            "type": "object",
            "properties": {
              "qualification_status": {
                "const": "qualified"
              }
            },
            "required": [
              "qualification_status"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "sbom",
              "provenance"
            ],
            "properties": {
              "images": {
                "minItems": 1,
                "type": "array"
              }
            },
            "not": {
              "type": "object",
              "required": [
                "unqualified_reason_code"
              ]
            }
          },
          "else": {
            "type": "object",
            "required": [
              "unqualified_reason_code"
            ]
          }
        }
      ]
    },
    "EnvironmentResourceV1": {
      "$comment": "Every resource identity embeds the run id, so cleanup can never target a foreign resource (design v2 \u00a722).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "kind",
        "run_scoped_name",
        "identity_hash",
        "destroyable"
      ],
      "properties": {
        "resource_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "kind": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "run_scoped_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "destroyable": {
          "type": "boolean"
        },
        "shared_with_other_runs": {
          "type": "boolean"
        }
      }
    },
    "EnvironmentResourceInventoryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "environment_instance_hash",
        "driver_manifest_hash",
        "resources",
        "inventoried_at",
        "core_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-resource-inventory/v1"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "environment_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "driver_manifest_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "resources": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "erl2:environment#/$defs/EnvironmentResourceV1"
          }
        },
        "inventoried_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "EnvironmentOperationReceiptV1": {
      "$comment": "Every external mutation is intent -> receipt -> event -> snapshot. A receipt carries before/after state and a compensation identifier where one applies.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "operation",
        "operation_id",
        "idempotency_key",
        "driver_manifest_hash",
        "target_identity_hash",
        "before_state_hash",
        "after_state_hash",
        "status",
        "started_at",
        "ended_at",
        "core_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-operation-receipt/v1"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "operation": {
          "$ref": "erl2:environment#/$defs/DriverOperation"
        },
        "operation_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "driver_manifest_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "target_identity_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "before_state_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "after_state_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "compensation_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "started_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "ended_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "error_code"
            ]
          },
          "else": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "error_code"
              ]
            }
          }
        }
      ]
    },
    "EnvironmentProbeResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "phase",
        "kind",
        "target_resource_id",
        "passed",
        "observation_hash"
      ],
      "properties": {
        "probe_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "phase": {
          "enum": [
            "readiness",
            "baseline",
            "fault",
            "restoration",
            "teardown"
          ]
        },
        "kind": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "target_resource_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "passed": {
          "type": "boolean"
        },
        "observation_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "failure_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "EnvironmentBaselineFingerprintV1": {
      "$comment": "The clean control. `fingerprint_hash` is derived from the ordered probe observations only, so two clean provisions of the same archetype produce identical bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "environment_instance_hash",
        "archetype_hash",
        "driver_manifest_hash",
        "probes",
        "evidence_source_states",
        "fingerprint_hash",
        "contamination",
        "observed_at",
        "core_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-baseline-fingerprint/v1"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "environment_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "archetype_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "driver_manifest_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "erl2:environment#/$defs/EnvironmentProbeResultV1"
          }
        },
        "evidence_source_states": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "state"
            ],
            "properties": {
              "source_id": {
                "$ref": "erl2:common#/$defs/Id"
              },
              "state": {
                "$ref": "erl2:common#/$defs/SourceState"
              }
            }
          }
        },
        "fingerprint_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "contamination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detected",
            "finding_codes"
          ],
          "properties": {
            "detected": {
              "type": "boolean"
            },
            "finding_codes": {
              "$ref": "erl2:common#/$defs/ShortStringArray"
            }
          }
        },
        "observed_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "EnvironmentResourceFrontierV1": {
      "$comment": "Frozen before emergency cleanup. The safe-action set is derived independently from the frontier, never supplied by the driver (ERL2-FR-025).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "environment_instance_hash",
        "driver_manifest_hash",
        "trigger",
        "observed_resources",
        "derived_actions",
        "frozen_at",
        "core_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-resource-frontier/v1"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "environment_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "driver_manifest_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "trigger": {
          "enum": [
            "provision_failure",
            "restoration_failure",
            "teardown_failure",
            "invalid_environment_failure"
          ]
        },
        "observed_resources": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "erl2:environment#/$defs/EnvironmentResourceV1"
          }
        },
        "derived_actions": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_id",
              "kind",
              "target_resource_id",
              "independently_safe"
            ],
            "properties": {
              "action_id": {
                "$ref": "erl2:common#/$defs/Id"
              },
              "kind": {
                "$ref": "erl2:results#/$defs/EmergencyCleanupActionKind"
              },
              "target_resource_id": {
                "$ref": "erl2:common#/$defs/Id"
              },
              "independently_safe": {
                "type": "boolean"
              },
              "unsafe_reason_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "independently_safe": {
                      "const": false
                    }
                  },
                  "required": [
                    "independently_safe"
                  ]
                },
                "then": {
                  "type": "object",
                  "required": [
                    "unsafe_reason_code"
                  ]
                },
                "else": {
                  "type": "object",
                  "not": {
                    "type": "object",
                    "required": [
                      "unsafe_reason_code"
                    ]
                  }
                }
              }
            ]
          }
        },
        "frozen_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "EnvironmentReservationLeaseV1": {
      "$comment": "The global allocator stores reservation leases only \u2014 never resource state (design v2 \u00a722).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "lease_id",
        "run_id",
        "reservation_kind",
        "reserved_value",
        "acquired_at",
        "expires_at",
        "core_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-reservation-lease/v1"
        },
        "lease_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "reservation_kind": {
          "enum": [
            "network",
            "volume",
            "port",
            "tenant",
            "project"
          ]
        },
        "reserved_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "acquired_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "expires_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "EnvironmentCleanupContractV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_id",
        "archetype_id",
        "expected_zero_residue_kinds",
        "permitted_retained_kinds",
        "teardown_probe_ids",
        "core_hash",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "environment-cleanup-contract/v1"
        },
        "contract_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "archetype_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "expected_zero_residue_kinds": {
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "permitted_retained_kinds": {
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "teardown_probe_ids": {
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "signature": {
          "$ref": "erl2:common#/$defs/Signature"
        }
      }
    },
    "ChallengeActivationReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Signed controller evidence that the selected challenge was activated in the provisioned environment (design v2 \u00a712 'activate/start/cutoff: signed controller and traffic receipts'). Additive contract ERL2-C-155 (ADR-ERL2-023); no existing schema changed. The controller is a separated role: the driver's own EnvironmentOperationReceiptV1 records what the substrate did and carries no signature, so it cannot attest who authorized the activation.",
      "required": [
        "schema_version",
        "receipt_id",
        "run_id",
        "selected_challenge_journey_binding_hash",
        "environment_instance_hash",
        "execution_plan_hash",
        "environment_fingerprint_hash",
        "connection_step_outcome_hash",
        "mutation_receipt_hash",
        "activated_at",
        "core_hash",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "challenge-activation-receipt/v1"
        },
        "receipt_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "selected_challenge_journey_binding_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "environment_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "execution_plan_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "environment_fingerprint_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "connection_step_outcome_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "mutation_receipt_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "activated_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "signature": {
          "$ref": "erl2:common#/$defs/Signature"
        }
      }
    },
    "SubstrateBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Signed Lab evidence binding one run permanently to one substrate identity (ADR-ERL2-024 \u00a74.2). Additive contract ERL2-C-156; no existing schema changed shape or meaning. It exists because `--substrate-root` was caller-controlled, ungated, and bound into no contract, no receipt and no attestation field, so a caller could drive the environment against substrate A and then destroy and finalize against a fresh empty substrate B, obtaining an offline-valid attestation while the real environment stayed allocated (review P0-1). The canonical identity is `substrate_instance_hash`, a value the substrate itself carries: a fresh substrate has none, which is what makes substitution detectable offline. The operational locator is deliberately ABSENT \u2014 a path is deployment-local, unstable across hosts, unverifiable by a reader who has no path to hash, and would bake an absolute host path into signed public evidence; it is kept in the run's private `state/` subtree instead. Signed by the environment governor, never by the driver: a driver is untrusted infrastructure and must not attest its own substrate identity.",
      "required": [
        "schema_version",
        "binding_id",
        "run_id",
        "driver_id",
        "driver_manifest_hash",
        "archetype_hash",
        "substrate_kind",
        "substrate_instance_hash",
        "reservation_namespace_hash",
        "bound_at",
        "core_hash",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "substrate-binding/v1"
        },
        "binding_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "driver_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "driver_manifest_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "archetype_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "substrate_kind": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "substrate_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "reservation_namespace_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "substrate_lock_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "bound_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "signature": {
          "$ref": "erl2:common#/$defs/Signature"
        }
      }
    },
    "ObservedResourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "One resource as the substrate reported it at a single moment: the driver's own resource id and the identity hash that derives from its run-scoped name. Both are retained because the two answer different questions — the id keys the derived actions, the identity hash keys the residue accounting.",
      "required": [
        "resource_id",
        "identity_hash"
      ],
      "properties": {
        "resource_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "identity_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "CleanupResidueProbeV1": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Lab evidence that the substrate was independently re-observed after the last cleanup dispatch (ADR-ERL2-027 §4.3). Additive contract ERL2-C-158; no existing schema changed shape or meaning. It exists because `EmergencyCleanupVerificationV1.remaining_resources` is derived by the producer from the producer's own action outcomes — so a cleanup that marked every action `succeeded` produced an empty residue that nothing offline could contradict, and a resource that vanished with no authorized action was undetectable (review P1-1, and §1.6). `observed_before` restates the pre-action frontier so a probe built over a post-destruction inventory is refused; `observed_after` is the observation nothing retained before; `authorized_targets` is the derived safe-action target set. `outcome` is derived from those three and is never supplied. Unsigned: an invalid terminal emits no attestation and no public bundle, so there is no external reader a signature would serve.",
      "required": [
        "schema_version",
        "probe_id",
        "run_id",
        "substrate_binding_hash",
        "environment_instance_hash",
        "resource_frontier_hash",
        "observed_before",
        "observed_after",
        "authorized_targets",
        "undeclared_destroyed_resources",
        "residual_resources",
        "probe_status",
        "outcome",
        "probed_at",
        "core_hash"
      ],
      "properties": {
        "schema_version": {
          "const": "cleanup-residue-probe/v1"
        },
        "probe_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "substrate_binding_hash": {
          "$comment": "The binding of ADR-ERL2-024 §4.2. A probe naming another run's substrate observed another environment.",
          "$ref": "erl2:common#/$defs/Hash"
        },
        "environment_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "resource_frontier_hash": {
          "$comment": "The pre-action frontier this probe closes over. The expectation must come from the frontier frozen before the first dispatch, never from an inventory reconstructed after one.",
          "$ref": "erl2:common#/$defs/Hash"
        },
        "observed_before": {
          "$comment": "The substrate as the frontier observed it, before any cleanup dispatch. Restated here so the probe stands alone and so a probe assembled over a later observation disagrees with the frontier it names.",
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "erl2:environment#/$defs/ObservedResourceIdentity"
          }
        },
        "observed_after": {
          "$comment": "The substrate re-observed after the last cleanup dispatch. This is the observation the verdict comes from, and the one that did not exist before this contract.",
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "erl2:environment#/$defs/ObservedResourceIdentity"
          }
        },
        "authorized_targets": {
          "$comment": "Resource ids the derived safe actions authorized a dispatch against. Anything absent afterwards that is not in this set disappeared without the Lab authorizing it.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "undeclared_destroyed_resources": {
          "$comment": "Resources present before, absent after, and never authorized. Non-empty is a Lab-integrity failure regardless of cause: the Lab cannot account for an effect it did not authorize.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "residual_resources": {
          "$comment": "Frontier members still observed afterwards. This is what `EmergencyCleanupVerificationV1.remaining_resources` must agree with, and the reason it is now checkable.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "probe_status": {
          "$comment": "`unavailable` when the substrate could not be re-observed. Fail-closed, not a pass: a cleanup that cannot be observed cannot be claimed complete.",
          "enum": [
            "observed",
            "unavailable"
          ]
        },
        "outcome": {
          "$comment": "Derived from the sets above, never supplied. `clean` is the only one that supports a complete cleanup; `undeclared_destruction` is the offline-detectable form of destroy-first-classify-afterwards.",
          "enum": [
            "clean",
            "residual",
            "undeclared_destruction",
            "unobservable"
          ]
        },
        "probed_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "ExpectedRevertedMutation": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "One mutation the compensation was expected to reverse, tied to the retained receipt that recorded it being applied and to the resource it was applied to.",
      "required": [
        "mutation_id",
        "mutation_receipt_hash",
        "target_identity_hash"
      ],
      "properties": {
        "mutation_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "mutation_receipt_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "target_identity_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        }
      }
    },
    "RestorationProbeV1": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Signed Lab evidence that the substrate was independently re-read after a compensation (ADR-ERL2-026 \u00a74). Additive contract ERL2-C-157; no existing schema changed shape or meaning. It exists because restoration was derived from the before/after baseline fingerprints, the residual resource set and the compensation receipt's own `status` \u2014 none of which can see a mutation. A driver that returned `status: \"succeeded\"` and reverted nothing produced `passed: true` over a mutation that was still applied, and 'reverted nothing' was indistinguishable from 'had nothing to revert' (review P1-4). `expected_reverted_mutations` names, from durable pre-compensation intent, exactly what the compensation was supposed to undo, and `observed_after` is what the substrate itself reported afterwards. `outcome` is derived from those two sets and is never asserted. Signed by the environment governor for the same reason the substrate binding is: the driver is untrusted infrastructure and must not be the authority on whether its own compensation worked.",
      "required": [
        "schema_version",
        "probe_id",
        "run_id",
        "substrate_binding_hash",
        "environment_instance_hash",
        "compensation_operation_id",
        "compensation_receipt_hash",
        "expected_reverted_mutations",
        "observed_before",
        "observed_after",
        "residual_expected_mutations",
        "collateral_reverted_mutations",
        "probe_status",
        "outcome",
        "probed_at",
        "core_hash",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "restoration-probe/v1"
        },
        "probe_id": {
          "$ref": "erl2:common#/$defs/Id"
        },
        "run_id": {
          "$ref": "erl2:common#/$defs/RunId"
        },
        "substrate_binding_hash": {
          "$comment": "The binding of \u00a74.2. A probe that names another run's substrate is a probe of another environment.",
          "$ref": "erl2:common#/$defs/Hash"
        },
        "environment_instance_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "compensation_operation_id": {
          "$comment": "The operation the receipt below belongs to. Pins a receipt to the compensation it is cited for, so a stale receipt replayed from another operation cannot stand in.",
          "$ref": "erl2:common#/$defs/Id"
        },
        "compensation_receipt_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "expected_reverted_mutations": {
          "$comment": "What the compensation was declared to revert, one entry per retained mutation receipt. Empty only when the run applied no mutation at all \u2014 which is what makes 'reverted nothing' and 'had nothing to revert' different outcomes rather than the same silence.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "erl2:environment#/$defs/ExpectedRevertedMutation"
          }
        },
        "observed_before": {
          "$comment": "Mutation ids the substrate reported applied immediately before the compensation was dispatched. On a resumed run whose compensation already completed this is legitimately empty; it is evidence, not a precondition.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "observed_after": {
          "$comment": "Mutation ids the substrate reported applied after the compensation, read back independently. This is the observation the verdict comes from.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "residual_expected_mutations": {
          "$comment": "Expected mutations still present in `observed_after`. Non-empty is a restoration failure whatever the receipt claimed.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "collateral_reverted_mutations": {
          "$comment": "Mutations present before that were removed without being expected. A compensation that reverted unrelated state did not restore the environment either, and must not be reported as if it had.",
          "$ref": "erl2:common#/$defs/IdArray"
        },
        "probe_status": {
          "$comment": "`unavailable` when the driver offers no applied-mutation observation. It is a fail-closed outcome, not a pass: a restoration that cannot be observed cannot be claimed.",
          "enum": [
            "observed",
            "unavailable"
          ]
        },
        "outcome": {
          "$comment": "Derived from the sets above, never supplied. `reverted` and `nothing_to_revert` are the only two that support a valid terminal, and they are deliberately distinct.",
          "enum": [
            "reverted",
            "nothing_to_revert",
            "residual",
            "collateral",
            "unobservable"
          ]
        },
        "probed_at": {
          "$ref": "erl2:common#/$defs/Instant"
        },
        "core_hash": {
          "$ref": "erl2:common#/$defs/Hash"
        },
        "signature": {
          "$ref": "erl2:common#/$defs/Signature"
        }
      }
    }
  }
}
