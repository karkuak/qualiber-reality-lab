        "sequence": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "request_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "dispatched_record_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "recovery_observation": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "cleanup_required": { "const": true },
        "observed_at": { "$ref": "erl2:common#/$defs/Instant" },
        "evidence_authenticity": { "const": "unauthenticated_local_record" },
        "core_hash": { "$ref": "erl2:common#/$defs/Hash" }
      }
    },
    "LocalObservationOperationRecordV1": {
      "oneOf": [
        { "$ref": "erl2:observation#/$defs/LocalObservationDeclaredRecordV1" },
        { "$ref": "erl2:observation#/$defs/LocalObservationDispatchedRecordV1" },
        { "$ref": "erl2:observation#/$defs/LocalObservationCompletedRecordV1" },
        { "$ref": "erl2:observation#/$defs/LocalObservationFailedRecordV1" },
        { "$ref": "erl2:observation#/$defs/LocalObservationAmbiguousRecordV1" }
      ]
    },
    "LocalStructuralValidationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "status", "evidence_refs"],
      "properties": {
        "contract": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["conforms", "does_not_conform", "not_applicable"] },
        "evidence_refs": { "$ref": "erl2:common#/$defs/HashArray" }
      }
    },
    "LocalCleanupResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stop", "compensation", "uninstall", "residue", "reason_codes"],
      "properties": {
        "status": { "enum": ["cleanup_complete", "cleanup_incomplete"] },
        "stop": { "enum": ["not_applicable", "completed", "failed", "ambiguous", "unsupported"] },
        "compensation": { "enum": ["not_applicable", "completed", "failed", "ambiguous", "unsupported"] },
        "uninstall": { "enum": ["not_applicable", "completed", "failed", "ambiguous", "unsupported"] },
        "residue": { "enum": ["observed_clean", "residue_detected", "not_observed"] },
        "reason_codes": { "$ref": "erl2:common#/$defs/ShortStringArray" }
      }
    },
    "LocalObservationResultV1": {
      "$comment": "The terminal of one local observation, discriminated by the same authority split as its plan. A result cannot describe a trusted-local run in certification vocabulary, and cannot describe a certified run without naming its receipt.",
      "oneOf": [
        { "$ref": "erl2:observation#/$defs/LocalObservationCertifiedResultV1" },
        { "$ref": "erl2:observation#/$defs/LocalObservationTrustedLocalResultV1" }
      ]
    },
    "LocalObservationCertifiedResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "plan_hash", "protocol_version", "adapter_id",
        "adapter_version", "adapter_manifest_hash", "certification_receipt_hash",
        "adapter_artifact_hash", "certification_authenticity", "operation_record_hashes",
        "retained_input_refs", "retained_output_refs", "retained_evidence_refs",
        "structural_validation", "cleanup", "status", "started_at", "ended_at",
        "not_scored", "not_governor_authorized", "unsupported_claims",
        "evidence_authenticity", "core_hash"
      ],
      "properties": {
        "schema_version": { "const": "local-observation-result/v1" },
        "observation_id": { "$ref": "erl2:common#/$defs/RunId" },
        "plan_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "protocol_version": { "const": "subject-adapter/v2" },
        "adapter_id": { "$ref": "erl2:common#/$defs/Id" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_manifest_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "certification_receipt_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "adapter_artifact_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "certification_authenticity": {
          "enum": ["locally_observed_unauthenticated", "authenticated"]
        },
        "operation_record_hashes": { "$ref": "erl2:common#/$defs/HashArray" },
        "retained_input_refs": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "erl2:observation#/$defs/LocalInputArtifactRefV1" }
        },
        "retained_output_refs": {
          "type": "array", "maxItems": 100000,
          "items": { "$ref": "erl2:common#/$defs/ArtifactRef" }
        },
        "retained_evidence_refs": { "$ref": "erl2:common#/$defs/HashArray" },
        "structural_validation": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "erl2:observation#/$defs/LocalStructuralValidationV1" }
        },
        "cleanup": { "$ref": "erl2:observation#/$defs/LocalCleanupResultV1" },
        "status": {
          "enum": [
            "observed_complete", "observed_with_unsupported", "observation_failed",
            "cleanup_incomplete", "observation_expired", "observation_cancelled"
          ]
        },
        "started_at": { "$ref": "erl2:common#/$defs/Instant" },
        "ended_at": { "$ref": "erl2:common#/$defs/Instant" },
        "not_scored": { "const": true },
        "not_governor_authorized": { "const": true },
        "unsupported_claims": { "$ref": "erl2:observation#/$defs/LocalUnsupportedClaimsV1" },
        "evidence_authenticity": { "const": "unauthenticated_local_record" },
        "core_hash": { "$ref": "erl2:common#/$defs/Hash" }
      }
    },
    "LocalObservationTrustedLocalResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "observation_id", "plan_hash", "protocol_version", "adapter_id",
        "adapter_version", "adapter_manifest_hash", "trusted_local_declaration_hash",
        "trust_mode", "adapter_artifact_hash", "operation_record_hashes",
        "retained_input_refs", "retained_output_refs", "retained_evidence_refs",
        "structural_validation", "cleanup", "status", "started_at", "ended_at",
        "not_scored", "not_governor_authorized", "not_independently_certified",
        "not_confined", "unsupported_claims", "evidence_authenticity", "core_hash"
      ],
      "properties": {
        "schema_version": { "const": "local-observation-result/v1" },
        "observation_id": { "$ref": "erl2:common#/$defs/RunId" },
        "plan_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "protocol_version": { "const": "subject-adapter/v2" },
        "adapter_id": { "$ref": "erl2:common#/$defs/Id" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_manifest_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "trusted_local_declaration_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "trust_mode": { "const": "trusted_local_code" },
        "adapter_artifact_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "operation_record_hashes": { "$ref": "erl2:common#/$defs/HashArray" },
        "retained_input_refs": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "erl2:observation#/$defs/LocalInputArtifactRefV1" }
        },
        "retained_output_refs": {
          "type": "array", "maxItems": 100000,
          "items": { "$ref": "erl2:common#/$defs/ArtifactRef" }
        },
        "retained_evidence_refs": { "$ref": "erl2:common#/$defs/HashArray" },
        "structural_validation": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "erl2:observation#/$defs/LocalStructuralValidationV1" }
        },
        "cleanup": { "$ref": "erl2:observation#/$defs/LocalCleanupResultV1" },
