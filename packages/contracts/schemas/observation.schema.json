      }
    },

    "TrustedLocalOperationOutcomeV1": {
      "$comment": "One planned operation as the run observed it. `response_status` is the adapter's own verdict and is present only when an exchange completed; it is never the Lab's judgement of the operation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "operation_id", "operation", "state", "request_hash", "operation_record_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "operation_id": { "$ref": "erl2:common#/$defs/Id" },
        "operation": { "$ref": "erl2:adapter#/$defs/AdapterOperationId" },
        "state": { "enum": ["completed", "failed", "ambiguous_not_replayed"] },
        "request_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "operation_record_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "response_envelope_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "response_status": { "enum": ["supported", "unsupported", "failed"] },
        "predecessor_operation_id": { "$ref": "erl2:common#/$defs/Id" },
        "predecessor_operation_record_hash": { "$ref": "erl2:common#/$defs/Hash" }
      }
    },

    "TrustedLocalObservationRecordV1": {
      "$comment": "The retained story of one owner-operated local observation, closed at every level so an offline reader can recompute it rather than trust it. It contains no verdict field an adapter could write into, and its trust ceiling is restated in its own bytes so the file alone cannot give a stronger impression than the evidence supports.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observation_id",
        "subject_execution_mode",
        "protocol_version",
        "trust_mode",
        "tier",
        "plan_hash",
        "plan_file_hash",
        "adapter_id",
        "adapter_version",
        "adapter_artifact_hash",
        "adapter_manifest_hash",
        "adapter_manifest_file_hash",
        "trusted_local_declaration",
        "trusted_local_declaration_hash",
        "trusted_local_declaration_file_hash",
        "admission_logical_path",
        "host_sandbox_profile",
        "host_control_report",
        "operation_outcomes",
        "operation_records",
        "residue_observations",
        "result",
        "cleanup",
        "terminal_status",
        "independent_certification",
        "confinement",
        "not_scored",
        "not_governor_authorized",
        "not_authenticated",
        "not_production_ready",
        "evidence_authenticity",
        "excluded_claims",
        "core_hash"
      ],
      "properties": {
        "schema_version": { "const": "trusted-local-observation-record/v1" },
        "observation_id": { "$ref": "erl2:common#/$defs/RunId" },
        "subject_execution_mode": { "const": "local_observation" },
        "protocol_version": { "const": "subject-adapter/v2" },
        "trust_mode": { "const": "trusted_local_code" },
        "tier": { "const": "development" },
        "plan_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "plan_file_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "adapter_id": { "$ref": "erl2:common#/$defs/Id" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_artifact_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "adapter_manifest_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "adapter_manifest_file_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "trusted_local_declaration": { "$ref": "erl2:adapter#/$defs/TrustedLocalAdapterDeclarationV1" },
        "trusted_local_declaration_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "trusted_local_declaration_file_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "admission_logical_path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "host_sandbox_profile": { "const": "local-process" },
        "host_control_report": {
          "type": "array", "maxItems": 64,
          "items": { "$ref": "erl2:adapter#/$defs/SandboxControlReportV2" }
        },
        "operation_outcomes": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "$ref": "erl2:observation#/$defs/TrustedLocalOperationOutcomeV1" }
        },
        "operation_records": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": { "$ref": "erl2:observation#/$defs/LocalObservationOperationRecordV1" }
        },
        "residue_observations": {
          "type": "array", "maxItems": 64,
          "items": { "$ref": "erl2:observation#/$defs/LocalResidueRecordV1" }
        },
        "result": { "$ref": "erl2:observation#/$defs/LocalObservationTrustedLocalResultV1" },
        "cleanup": { "$ref": "erl2:observation#/$defs/LocalCleanupResultV1" },
        "terminal_status": {
          "enum": [
            "observed_complete", "observed_with_unsupported", "observation_failed",
            "cleanup_incomplete", "observation_expired", "observation_cancelled"
          ]
        },
        "independent_certification": { "const": "absent" },
        "confinement": { "const": "absent" },
        "not_scored": { "const": true },
        "not_governor_authorized": { "const": true },
        "not_authenticated": { "const": true },
        "not_production_ready": { "const": true },
        "evidence_authenticity": { "const": "unauthenticated_local_record" },
        "excluded_claims": { "$ref": "erl2:observation#/$defs/LocalUnsupportedClaimsV1" },
        "core_hash": { "$ref": "erl2:common#/$defs/Hash" }
      }
    }
  }
}
