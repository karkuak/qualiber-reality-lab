    },
    "LocalObservationCompletedRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "state", "observation_id", "plan_hash", "operation_id", "operation",
        "sequence", "request_hash", "dispatched_record_hash", "response_envelope_hash",
        "sandbox_manifest_hash", "sandbox_result_hash", "mutation_receipt_hashes",
        "compensation_receipt_hashes", "retained_input_refs", "retained_output_refs",
        "response_status", "cleanup_eligible", "started_at", "ended_at",
        "evidence_authenticity", "core_hash"
      ],
      "properties": {
        "schema_version": { "const": "local-observation-operation-record/v1" },
        "state": { "const": "completed" },
        "observation_id": { "$ref": "erl2:common#/$defs/RunId" },
        "plan_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "operation_id": { "$ref": "erl2:common#/$defs/Id" },
        "operation": { "$ref": "erl2:adapter#/$defs/AdapterOperationId" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "request_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "dispatched_record_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "response_envelope_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "sandbox_manifest_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "sandbox_result_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "diagnostics_manifest_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "mutation_receipt_hashes": { "$ref": "erl2:common#/$defs/HashArray" },
        "compensation_receipt_hashes": { "$ref": "erl2:common#/$defs/HashArray" },
        "retained_input_refs": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "erl2:observation#/$defs/LocalInputArtifactRefV1" }
        },
        "retained_output_refs": {
          "type": "array", "maxItems": 100000,
          "items": { "$ref": "erl2:common#/$defs/ArtifactRef" }
        },
        "response_status": {
          "$comment": "The adapter's own verdict for this operation, kept separate from the record state. `completed` means the exchange completed and its evidence froze; it never means the adapter succeeded.",
          "enum": ["supported", "failed", "unsupported"]
        },
        "residue_observation": {
          "$comment": "Present only for a report-residue operation the adapter supported. Absent means no residue was observed, which is not the same as observing none.",
          "$ref": "erl2:observation#/$defs/LocalResidueRecordV1"
        },
        "cleanup_eligible": { "type": "boolean" },
        "started_at": { "$ref": "erl2:common#/$defs/Instant" },
        "ended_at": { "$ref": "erl2:common#/$defs/Instant" },
        "evidence_authenticity": { "const": "unauthenticated_local_record" },
        "core_hash": { "$ref": "erl2:common#/$defs/Hash" }
      }
    },
    "LocalObservationFailedRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "state", "observation_id", "plan_hash", "operation_id", "operation",
        "sequence", "request_hash", "dispatched_record_hash", "failure_code",
        "cleanup_required", "started_at", "failed_at", "evidence_authenticity", "core_hash"
      ],
      "properties": {
        "schema_version": { "const": "local-observation-operation-record/v1" },
        "state": { "const": "failed" },
        "observation_id": { "$ref": "erl2:common#/$defs/RunId" },
        "plan_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "operation_id": { "$ref": "erl2:common#/$defs/Id" },
        "operation": { "$ref": "erl2:adapter#/$defs/AdapterOperationId" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 1023 },
        "request_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "dispatched_record_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "response_envelope_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "sandbox_manifest_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "sandbox_result_hash": { "$ref": "erl2:common#/$defs/Hash" },
        "failure_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "cleanup_required": { "type": "boolean" },
        "started_at": { "$ref": "erl2:common#/$defs/Instant" },
        "failed_at": { "$ref": "erl2:common#/$defs/Instant" },
        "evidence_authenticity": { "const": "unauthenticated_local_record" },
        "core_hash": { "$ref": "erl2:common#/$defs/Hash" }
      }
    },
    "LocalObservationAmbiguousRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "state", "observation_id", "plan_hash", "operation_id", "operation",
        "sequence", "request_hash", "dispatched_record_hash", "recovery_observation",
        "cleanup_required", "observed_at", "evidence_authenticity", "core_hash"
      ],
      "properties": {
        "schema_version": { "const": "local-observation-operation-record/v1" },
        "state": { "const": "ambiguous_not_replayed" },
        "observation_id": { "$ref": "erl2:common#/$defs/RunId" },
